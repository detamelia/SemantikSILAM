<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology/mahasiswa#"
     xml:base="http://example.org/ontology/mahasiswa"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:mhs="http://example.org/ontology/mahasiswa#">
    
    <owl:Ontology rdf:about="http://example.org/ontology/mahasiswa">
        <rdfs:label>Ontologi Data Mahasiswa Terintegrasi</rdfs:label>
        <rdfs:comment>Ontologi master mahasiswa untuk Sistem A dan persiapan integrasi Sistem B pada UTS Semantic Web.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/ontology/mahasiswa#Mahasiswa">
        <rdfs:label>Mahasiswa</rdfs:label>
        <rdfs:comment>Entitas mahasiswa aktif pada institusi pendidikan.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/mahasiswa#ProgramStudi">
        <rdfs:label>Program Studi</rdfs:label>
        <rdfs:comment>Program studi yang diikuti oleh mahasiswa.</rdfs:comment>
    </owl:Class>

    <!-- Datatype Properties -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/mahasiswa#npm">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/mahasiswa#Mahasiswa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Nomor Pokok Mahasiswa</rdfs:label>
        <rdfs:comment>Identitas unik pembeda mahasiswa.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/mahasiswa#namaMahasiswa">
        <rdfs:domain rdf:resource="http://example.org/ontology/mahasiswa#Mahasiswa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Nama Mahasiswa</rdfs:label>
        <rdfs:comment>Nama lengkap mahasiswa.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/mahasiswa#programStudi">
        <rdfs:domain rdf:resource="http://example.org/ontology/mahasiswa#Mahasiswa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Program Studi</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/mahasiswa#angkatan">
        <rdfs:domain rdf:resource="http://example.org/ontology/mahasiswa#Mahasiswa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:label>Angkatan</rdfs:label>
    </owl:DatatypeProperty>
</rdf:RDF>
